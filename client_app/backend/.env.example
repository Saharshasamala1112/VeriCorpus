# VeriCorpus AI — Environment Configuration

APP_NAME=VeriCorpus AI
APP_VERSION=1.0.0
DEBUG=true

# Core service settings
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vericorpus
CORPUS_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/indic_corpus
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,https://localhost:5173
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=uploads

# External provider keys
CORPUS_BASE_URL=https://api.corpus.swecha.org
CORPUS_PHONE=your_phone_number
CORPUS_PASSWORD=your_password
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Email Service (for password reset)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
FROM_EMAIL=noreply@vericorpus.ai
FROM_NAME=VeriCorpus AI
FRONTEND_URL=http://localhost:5173

# ML / model settings
LEARNING_DB_PATH=data/corpusguard_learning.sqlite3
FORENSIC_MODEL_ROOT=/absolute/path/to/deepshield
FORENSIC_MODEL_PATH=/absolute/path/to/deepshield/models/best_model.pth
FORENSIC_OUTPUT_DIR=outputs/forensic
FORENSIC_ENABLED=true

# Optional behavior tuning
RATE_LIMIT_PER_MINUTE=60
ALLOWED_MIME_TYPES=